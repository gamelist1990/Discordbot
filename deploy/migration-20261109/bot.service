[Unit]
Description=Discord Bot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Discordbot
Environment="PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.deno/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/ubuntu/.bun/bin/bun run src/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryLow=256M
UMask=0077

[Install]
WantedBy=multi-user.target
